<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pabrik Data AI (JSON)"
            android:textColor="#4CAF50"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hasilkan data pelatihan secara otomatis dan simpan langsung ke folder Download."
            android:textColor="#AAAAAA"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/edtApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gemini API Key"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Topik (Misal: Hadits Arab, Coding Kotlin)"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/edtJumlah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="50"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Generate &amp; Unduh JSON" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>